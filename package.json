{
  "name": "dsh-whale-persona",
  "version": "0.4.0",
  "description": "DeepSeek 鲸鱼娘人设插件：会话级开关（每个会话单独启用/关闭），对话输入栏提供胶囊，设置页可编辑人设正文，清空即恢复默认。",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Everelast/dsh-whale-persona.git"
  },
  "homepage": "https://github.com/Everelast/dsh-whale-persona#readme",
  "bugs": {
    "url": "https://github.com/Everelast/dsh-whale-persona/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "persona",
    "whale"
  ],
  "license": "MIT"
}
